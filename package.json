{
    "name": "outline",
    "homepage": "https://sean1093.github.io/outline",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "sync": "node scripts/sync.ts",
        "refresh-fixture": "node scripts/refresh-fixture.ts",
        "predeploy": "yarn build && cp dist/index.html dist/404.html",
        "deploy": "gh-pages -d dist",
        "format": "prettier --write ."
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^24",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "fast-xml-parser": "^5.11.1",
        "gh-pages": "^6.3.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.18.2",
        "vite": "^6.0.5",
        "vitest": "^4.1.11"
    },
    "resolutions": {
        "vite": "^6.0.5"
    }
}
